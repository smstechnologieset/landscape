# ---------------------------------------------------------------------------
# Landscape Solution PLC - environment configuration
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Supabase project (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for admin operations (storage cleanup etc).
# NEVER reference this in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for SEO metadata / canonical URLs / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email provider (used only inside Supabase Edge Functions)
EMAIL_FROM="Landscape Solution PLC <no-reply@example.com>"
EMAIL_TO=info@example.com
EMAIL_PROVIDER_API_KEY=

# WhatsApp contact number in international format without "+" e.g. 251911223344
WHATSAPP_NUMBER=251900000000

# Google Maps embed/share URL shown on the Contact page
NEXT_PUBLIC_GOOGLE_MAPS_URL=
